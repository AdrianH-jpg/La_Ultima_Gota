# ESCENA 3A - FONDO NEGRO (sobreimpresos, sin barra)
~ start
do Climate.set_visuals(false)
do Director.hide_all_characters()
do Director.black()
do Director.background("negro")
do Director.wait(1.0)
do Director.caption("17 AÑOS MÁS TARDE", 1.0, 2.0)
do Director.caption("Martes 5 de noviembre de 1985", 1.0, 2.0)
do Director.goto("escena_03b_cocina")
=> END
