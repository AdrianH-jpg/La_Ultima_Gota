"14": {
&"character": "Directora",
&"id": "14",
&"next_id": "15",
&"static_id": "",
&"text": "¿Usted tiene idea de la gravedad de lo que acaba de hacer? ¡Su compañera no sabe nadar! ¡Se podría haber ahogado!",
&"type": "dialogue"
},
