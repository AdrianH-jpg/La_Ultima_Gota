"2": {
&"character": "José",
&"id": "2",
&"next_id": "3",
&"static_id": "",
&"text": "Respira. Hey-- tranquila, ya pasó todo-- Estás bien, ya estás bien.",
&"type": "dialogue"
},
"20": {
&"character": "Pilar",
&"id": "20",
&"next_id": "21",
&"static_id": "",
&"text": "Ay, señora directora, tampoco es para tanto. Seguro está haciendo todo este teatro para llamar la atención. ¡Siempre se hace la mosquita muerta!",
&"type": "dialogue"
},
