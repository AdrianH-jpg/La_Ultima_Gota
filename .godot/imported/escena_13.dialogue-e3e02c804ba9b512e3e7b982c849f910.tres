"18": {
&"character": "Directora",
&"id": "18",
&"next_id": "19",
&"static_id": "",
&"text": "¡No terminé de hablar, señorita! Si su compañero no hubiera intervenido, en este momento podríamos estar lamentando una desgracia. ¿Es consciente de eso? ¡No fue gracioso!",
&"type": "dialogue"
},
