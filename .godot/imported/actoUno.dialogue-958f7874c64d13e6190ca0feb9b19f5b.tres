lines = {
"0": {
&"id": "0",
&"next_id": "1",
&"type": "cue"
},
"1": {
&"id": "1",
&"next_id": "3",
&"static_id": "",
&"text": "Noviembre de 1978. Provincia de La Pampa",
&"type": "dialogue"
},
"10": {
&"id": "10",
&"next_id": "11",
&"type": ""
},
"11": {
&"id": "11",
&"next_id": "12",
&"type": "cue"
},
"12": {
&"id": "12",
&"next_id": "14",
&"static_id": "",
&"text": "El sobre está arrugado por el viaje.",
&"type": "dialogue"
},
"13": {
&"id": "13",
&"next_id": "14",
&"type": ""
},
"14": {
&"character": "Remitente",
&"id": "14",
&"next_id": "16",
&"static_id": "",
&"text": "Osvaldo Corvalán Iraola. 
La Armonía, La Pampa.",
&"type": "dialogue"
},
"15": {
&"id": "15",
&"next_id": "16",
&"type": ""
},
"16": {
&"id": "16",
&"next_id": "18",
&"static_id": "",
&"text": "El apellido te resulta familiar. 
Los Corvalán Iraola llevan generaciones enteras acumulando tierras y ganado.",
&"type": "dialogue"
},
"17": {
&"id": "17",
&"next_id": "18",
&"type": ""
},
"18": {
&"id": "18",
&"next_id": "19",
&"responses": PackedStringArray("18", "20"),
&"static_id": "",
&"text": "Abrir telegrama",
&"type": "response"
},
"19": {
&"id": "19",
&"is_snippet": false,
&"next_id": "32",
&"next_id_after": "",
&"type": "goto"
},
"2": {
&"id": "2",
&"next_id": "3",
&"type": ""
},
"20": {
&"id": "20",
&"next_id": "21",
&"static_id": "",
&"text": "Dejar sobre la mesa",
&"type": "response"
},
"21": {
&"id": "21",
&"is_snippet": false,
&"next_id": "25",
&"next_id_after": "",
&"type": "goto"
},
"23": {
&"id": "23",
&"next_id": "24",
&"type": ""
},
"24": {
&"id": "24",
&"next_id": "25",
&"type": "cue"
},
"25": {
&"id": "25",
&"next_id": "27",
&"static_id": "",
&"text": "Decides dejar el telegrama sobre la mesa, sin abrir.",
&"type": "dialogue"
},
"26": {
&"id": "26",
&"next_id": "27",
&"type": ""
},
"27": {
&"id": "27",
&"next_id": "28",
&"static_id": "",
&"text": "Tal vez más tarde.",
&"type": "dialogue"
},
"28": {
&"id": "28",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
"3": {
&"id": "3",
&"next_id": "5",
&"static_id": "",
&"text": "El ventilador del techo gira lentamente, arrastrando el aire caliente de una oficina que conoce días mejores. Afuera el sol ya empieza a descender, el clima igual no muestra clemencia.",
&"type": "dialogue"
},
"30": {
&"id": "30",
&"next_id": "31",
&"type": ""
},
"31": {
&"id": "31",
&"next_id": "32",
&"type": "cue"
},
"32": {
&"id": "32",
&"next_id": "34",
&"static_id": "",
&"text": "Despliegas el papel cuidadosamente.",
&"type": "dialogue"
},
"33": {
&"id": "33",
&"next_id": "34",
&"type": ""
},
"34": {
&"id": "34",
&"next_id": "36",
&"static_id": "",
&"text": "La tinta está algo corrida.",
&"type": "dialogue"
},
"35": {
&"id": "35",
&"next_id": "36",
&"type": ""
},
"36": {
&"id": "36",
&"next_id": "38",
&"static_id": "",
&"text": "\"Dr. Felipe Macedonio Ramírez. 
Solicito con carácter urgente sus servicios profesionales para investigar una serie de muertes inusuales de ganado ocurridas en mi establecimiento.",
&"type": "dialogue"
},
"37": {
&"id": "37",
&"next_id": "38",
&"type": ""
},
"38": {
&"id": "38",
&"next_id": "40",
&"static_id": "",
&"text": "La situación requiere absoluta discreción.
Los honorarios serán abonados en dólares estadounidenses, el monto será discutido con usted al momento de su visita.",
&"type": "dialogue"
},
"39": {
&"id": "39",
&"next_id": "40",
&"type": ""
},
"4": {
&"id": "4",
&"next_id": "5",
&"type": ""
},
"40": {
&"id": "40",
&"next_id": "42",
&"static_id": "",
&"text": "Le solicito a su favor, una pronta respuesta.",
&"type": "dialogue"
},
"41": {
&"id": "41",
&"next_id": "42",
&"type": ""
},
"42": {
&"id": "42",
&"next_id": "44",
&"static_id": "",
&"text": "Atentamente, 
Osvaldo Corvalán Iraola.\"",
&"type": "dialogue"
},
"43": {
&"id": "43",
&"next_id": "44",
&"type": ""
},
"44": {
&"id": "44",
&"next_id": "46",
&"static_id": "",
&"text": "Terminas de leer.
Y lo vuelves a leer.
Después una tercera vez…",
&"type": "dialogue"
},
"45": {
&"id": "45",
&"next_id": "46",
&"type": ""
},
"46": {
&"id": "46",
&"next_id": "48",
&"static_id": "",
&"text": "Dólares.
No pesos…
Dólares.",
&"type": "dialogue"
},
"47": {
&"id": "47",
&"next_id": "48",
&"type": ""
},
"48": {
&"id": "48",
&"next_id": "50",
&"static_id": "",
&"text": "Te reclinas en la silla. Algo no encaja.",
&"type": "dialogue"
},
"49": {
&"id": "49",
&"next_id": "50",
&"type": ""
},
"5": {
&"id": "5",
&"next_id": "7",
&"static_id": "",
&"text": "Sobre el escritorio se acumulan carpetas, formularios y estudios clínicos. Algunas facturas esperan ser pagadas. Otras ya deberían haberlo sido hace semanas.",
&"type": "dialogue"
},
"50": {
&"id": "50",
&"next_id": "52",
&"static_id": "",
&"text": "Las vacas siempre se enferman.
Las vacas siempre se mueren.",
&"type": "dialogue"
},
"51": {
&"id": "51",
&"next_id": "52",
&"type": ""
},
"52": {
&"id": "52",
&"next_id": "54",
&"static_id": "",
&"text": "Eso es parte del negocio.
Nadie paga semejante suma para investigar un puñado de animales muertos.",
&"type": "dialogue"
},
"53": {
&"id": "53",
&"next_id": "54",
&"type": ""
},
"54": {
&"id": "54",
&"next_id": "56",
&"static_id": "",
&"text": "A menos que esos animales estén ocultando algo más.
O que alguien necesite una respuesta urgente.",
&"type": "dialogue"
},
"55": {
&"id": "55",
&"next_id": "56",
&"type": ""
},
"56": {
&"id": "56",
&"next_id": "58",
&"static_id": "",
&"text": "La foto de tu hija descansa sobre el escritorio.",
&"type": "dialogue"
},
"57": {
&"id": "57",
&"next_id": "58",
&"type": ""
},
"58": {
&"id": "58",
&"next_id": "60",
&"static_id": "",
&"text": "Buenos Aires.
Alquiler.
Libros.
Cuotas.
Comida.",
&"type": "dialogue"
},
"59": {
&"id": "59",
&"next_id": "60",
&"type": ""
},
"6": {
&"id": "6",
&"next_id": "7",
&"type": ""
},
"60": {
&"id": "60",
&"next_id": "62",
&"static_id": "",
&"text": "La universidad no se paga sola.
Suspiras.
No te gusta el asunto.",
&"type": "dialogue"
},
"61": {
&"id": "61",
&"next_id": "62",
&"type": ""
},
"62": {
&"id": "62",
&"next_id": "64",
&"static_id": "",
&"text": "Pero tampoco estás en posición de rechazar el dinero.
Y, después de todo, probablemente la explicación es mucho más simple de lo que parece.
Siempre lo es...",
&"type": "dialogue"
},
"63": {
&"id": "63",
&"next_id": "64",
&"type": ""
},
"64": {
&"id": "64",
&"next_id": "65",
&"responses": PackedStringArray("64"),
&"static_id": "",
&"text": "Aceptar el trabajo",
&"type": "response"
},
"65": {
&"id": "65",
&"is_snippet": false,
&"next_id": "69",
&"next_id_after": "",
&"type": "goto"
},
"67": {
&"id": "67",
&"next_id": "68",
&"type": ""
},
"68": {
&"id": "68",
&"next_id": "69",
&"type": "cue"
},
"69": {
&"id": "69",
&"next_id": "71",
&"static_id": "",
&"text": "Guardas el telegrama dentro del maletín.",
&"type": "dialogue"
},
"7": {
&"id": "7",
&"next_id": "8",
&"static_id": "",
&"text": "Entre todo ese desorden hay un telegrama que todavía está sin abrir.",
&"type": "dialogue"
},
"70": {
&"id": "70",
&"next_id": "71",
&"type": ""
},
"71": {
&"id": "71",
&"next_id": "72",
&"static_id": "",
&"text": "Mañana partirás hacia La Armonía.",
&"type": "dialogue"
},
"72": {
&"id": "72",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
"73": {
&"id": "73",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
"8": {
&"id": "8",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
}
}
