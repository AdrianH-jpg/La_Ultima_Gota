},
"31": {
&"character": "Patricia",
&"id": "31",
&"next_id": "32",
&"static_id": "",
&"text": "¡¿Quién sos?! ¡No me lastimes! ¡¿Qué hiciste con Eva?! ¡Ayuda!",
&"type": "dialogue"
},
