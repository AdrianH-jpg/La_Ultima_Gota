; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="La Estancia"
run/main_scene="uid://d1ihp8mipcl1v"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="uid://b6w4sgmf1cmxj"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
Climate="*uid://cl176mus5yj3d"
Guion="*uid://dbyb2w663whw8"

[dialogue_manager]

runtime/balloon_path="res://dialogue/scene_dialogue/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

